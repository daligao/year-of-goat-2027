{
  "name": "cft-online-seo-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "browser": {
    "binding": "BROWSER"
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "CONTENT_QUEUE"
    }
  ],
  "triggers": {
    "crons": [
      "17 1 * * 2,5"
    ]
  }
}
