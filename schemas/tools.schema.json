{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tools.schema.json",
  "title": "Tools Registry",
  "type": "object",
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "subtitle", "emoji", "url", "status", "launched", "funnel"],
        "properties": {
          "id":               { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title":            { "type": "string", "minLength": 3 },
          "subtitle":         { "type": "string", "minLength": 5 },
          "emoji":            { "type": "string" },
          "url":              { "type": "string", "pattern": "^/[a-z0-9/-]+/$" },
          "status":           { "type": "string", "enum": ["testing", "growing", "graduated", "retired"] },
          "stage":            { "type": "string", "enum": ["lab", "beta", "stable"] },
          "launched":         { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "review_after_days":{ "type": "integer", "minimum": 7, "maximum": 365 },
          "priority":         { "type": "number", "minimum": 0, "maximum": 1 },
          "tags":             { "type": "array", "items": { "type": "string" } },
          "funnel":           { "type": "string" },
          "description":      { "type": "string" },
          "cta":              { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
