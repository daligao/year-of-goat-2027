{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ideas.schema.json",
  "title": "Community Ideas",
  "type": "object",
  "required": ["updated", "ideas"],
  "properties": {
    "updated": { "type": "string" },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "votes"],
        "properties": {
          "id":      { "type": "integer" },
          "title":   { "type": "string" },
          "body":    { "type": "string" },
          "votes":   { "type": "integer", "minimum": 0 },
          "url":     { "type": "string" },
          "author":  { "type": "string" },
          "created": { "type": "string" }
        }
      }
    }
  }
}
