{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "description",
    "status",
    "type",
    "updatedAt",
    "sourceUrl"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://chinesefortunetools\\.online/"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "published"
      ]
    },
    "type": {
      "enum": [
        "festival",
        "zodiac",
        "greeting",
        "tool"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "data": {
      "type": "object",
      "minProperties": 1
    }
  },
  "oneOf": [
    {
      "required": [
        "body"
      ],
      "not": {
        "required": [
          "data"
        ]
      }
    },
    {
      "required": [
        "data"
      ],
      "not": {
        "required": [
          "body"
        ]
      }
    }
  ]
}
