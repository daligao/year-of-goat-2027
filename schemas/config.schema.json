{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "config.schema.json",
  "title": "Site Config",
  "type": "object",
  "required": ["kill_switches", "banners", "cta"],
  "properties": {
    "kill_switches": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "banners": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled":   { "type": "boolean" },
        "message":   { "type": "string" },
        "style":     { "type": "string", "enum": ["info", "warning", "error", "success"] },
        "link":      { "type": "string" },
        "link_text": { "type": "string" }
      }
    },
    "cta": {
      "type": "object",
      "required": ["primary_site", "primary_label", "primary_url"],
      "properties": {
        "primary_site":  { "type": "string" },
        "primary_label": { "type": "string" },
        "primary_url":   { "type": "string", "format": "uri" }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "stages": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
